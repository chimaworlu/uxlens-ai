generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PlanTier {
  FREE
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

enum DocumentStatus {
  UPLOADED
  EXTRACTING
  READY
  FAILED
}

enum DocumentType {
  PDF
  DOCX
  TXT
  CSV
}

enum AnalysisStatus {
  QUEUED
  PROCESSING
  READY
  FAILED
  STALE
}

enum InsightType {
  THEME
  PAIN_POINT
  SUGGESTION
  CONTRADICTION
}

enum ChatRole {
  USER
  ASSISTANT
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  name          String?
  image         String?
  plan          PlanTier  @default(FREE)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  projects     Project[]
  subscription Subscription?
  usageRecords UsageRecord[]
  accounts     Account[]
  sessions     Session[]
  paymentLogs  PaymentLog[]
}

// Auth.js standard models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id         String    @id @default(cuid())
  userId     String
  name       String
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents    Document[]
  analyses     Analysis[]
  chatMessages ChatMessage[]

  @@index([userId, archivedAt])
}

model Document {
  id            String         @id @default(cuid())
  projectId     String
  filename      String
  type          DocumentType
  status        DocumentStatus @default(UPLOADED)
  failureReason String?
  r2Key         String         @unique
  sizeBytes     Int
  pageCount     Int?
  extractedText String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chunks  DocumentChunk[]
  // Note: extractedText can be large (full document text). It must be excluded
  // from default Prisma selects on Document (use an explicit `select` that omits
  // it for list/status queries); fetch it explicitly only where needed — the
  // worker (chunking) and the citation panel (surrounding-text lookup).

  @@index([projectId, status])
}

model DocumentChunk {
  id           String                   @id @default(cuid())
  documentId   String
  ordinal      Int
  content      String
  charStart    Int
  charEnd      Int
  pageNumber   Int?
  searchVector Unsupported("tsvector")?

  document  Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  citations Citation[]
  // Created via raw SQL migration:
  // CREATE INDEX chunk_search_idx ON "DocumentChunk" USING GIN ("searchVector");
  // CREATE TRIGGER chunk_search_update BEFORE INSERT OR UPDATE ON "DocumentChunk"
  //   FOR EACH ROW EXECUTE FUNCTION
  //   tsvector_update_trigger("searchVector", 'pg_catalog.english', content);

  @@unique([documentId, ordinal])
  @@index([documentId])
}

model Analysis {
  id               String         @id @default(cuid())
  projectId        String
  version          Int
  status           AnalysisStatus @default(QUEUED)
  failureReason    String?
  progressStage    String?
  executiveSummary String?
  costUsd          Decimal?       @db.Decimal(8, 4)
  documentCount    Int            @default(0)
  createdAt        DateTime       @default(now())
  completedAt      DateTime?

  project         Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  insights        Insight[]
  sourceDocuments AnalysisDocument[]

  @@unique([projectId, version])
  @@index([projectId, status])
}

model AnalysisDocument {
  id         String @id @default(cuid())
  analysisId String
  // documentId is intentionally NOT a foreign key into Document. This row
  // is a snapshot of which document fed this analysis, taken at run time —
  // it has to survive the source Document being deleted later (that's the
  // whole point: deleting a document sets the analysis STALE, which this
  // table is what makes detectable). A real FK with cascade would delete
  // this row right along with the Document, destroying the evidence.
  documentId String
  filename   String

  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
  @@index([documentId])
}

model Insight {
  id            String      @id @default(cuid())
  analysisId    String
  type          InsightType
  title         String
  description   String
  rank          Int
  evidenceCount Int         @default(1)
  starred       Boolean     @default(false)

  analysis  Analysis   @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  citations Citation[]

  @@index([analysisId, type, rank])
}

model Citation {
  id            String  @id @default(cuid())
  insightId     String?
  chatMessageId String?
  chunkId       String
  quote         String
  charStart     Int
  charEnd       Int

  insight     Insight?      @relation(fields: [insightId], references: [id], onDelete: Cascade)
  chatMessage ChatMessage?  @relation(fields: [chatMessageId], references: [id], onDelete: Cascade)
  chunk       DocumentChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@index([insightId])
  @@index([chatMessageId])
  @@index([chunkId])
}

model ChatMessage {
  id        String    @id @default(cuid())
  projectId String
  role      ChatRole
  content   String
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  citations Citation[]

  @@index([projectId, createdAt])
}

model Subscription {
  id                       String             @id @default(cuid())
  userId                   String             @unique
  status                   SubscriptionStatus
  paystackPlanCode         String
  paystackCustomerCode     String?
  // Paystack's disable-subscription endpoint needs BOTH of these together
  // (unlike the previous Flutterwave integration's single numeric id) —
  // added for the same reason the Flutterwave fields were: FR-35's
  // self-serve cancel can't be built without them. Nullable: unset until
  // the first successful charge webhook populates them.
  paystackSubscriptionCode String?
  paystackEmailToken       String?
  currentPeriodEnd         DateTime
  cancelAtPeriodEnd        Boolean            @default(false)
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UsageRecord {
  id        String   @id @default(cuid())
  userId    String
  kind      String // "analysis_run" | "chat_message"
  costUsd   Decimal? @db.Decimal(8, 4)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Note: FR-21's monthly quota and FR-31's daily chat cap are enforced by
  // counting UsageRecord rows for the current period via this index at
  // request time. No separate counter/cache table at MVP; revisit only if
  // this query shows up as a bottleneck.

  @@index([userId, kind, createdAt])
}

model WebhookEvent {
  id         String   @id @default(cuid())
  provider   String // "paystack"
  txRef      String   @unique
  payload    Json
  processed  Boolean  @default(false)
  receivedAt DateTime @default(now())
}

// The trusted, append-only audit trail of every payment-related event this
// app has ever seen for every transaction — not just the ones that
// succeeded. Distinct from WebhookEvent, which exists purely for webhook
// delivery idempotency (one row per txRef, updated in place). PaymentLog
// takes one new row per event, keyed loosely: a single reference can (and
// normally does) accumulate several rows over its lifetime — checkout
// initiated, a redirect-verify call, a webhook delivery — so this table can
// answer "what did Paystack actually tell us, and when" independent of
// whatever Subscription/User.plan currently say. Nothing here is ever
// updated or deleted after insert.
model PaymentLog {
  id     String  @id @default(cuid())
  userId String?
  // "paystack" — kept as a column rather than assumed, same reasoning as
  // WebhookEvent.provider, in case a second provider is ever added.
  provider String
  // Where this event was observed: "checkout" (link created, not yet
  // paid), "webhook" (Paystack's server calling ours), or "verify" (the
  // checkout-redirect confirmation path in app/api/billing/verify).
  source String
  // Paystack's own event name for webhook rows (e.g. "charge.success"),
  // or a route-defined label for the other two sources (e.g.
  // "checkout.initiated", "checkout.verify").
  event String
  // Paystack's transaction reference. Not unique here on purpose — see the
  // model comment above.
  reference String
  // Paystack's transaction status ("success", "failed", "abandoned", ...)
  // when one was actually returned, or a rejection reason coined by our
  // own route when it wasn't ("signature_invalid", "invalid_payload",
  // "customer_mismatch", "verify_api_error", "duplicate").
  status           String
  amountKobo       Int?
  currency         String?
  customerEmail    String?
  planCode         String?
  subscriptionCode String?
  // Webhook rows only: whether x-paystack-signature checked out. Null for
  // "checkout"/"verify" rows — there's no signature in either path (verify
  // authenticates via session + a live Paystack API round-trip instead).
  signatureValid Boolean?
  // Whether this specific event is what triggered
  // activateProSubscription — lets a reconciliation query find exactly the
  // row that turned a user's plan on, not just that it eventually did.
  activated Boolean @default(false)
  // Set on a rejected or failed attempt (bad signature, API error,
  // customer mismatch, etc.); null on a normal successful entry.
  errorMessage String?
  // Full provider payload/response for this event, verbatim, for manual
  // reconciliation against Paystack's own dashboard. Nullable only for the
  // rare case an attempt was rejected before any payload existed to store
  // (e.g. a Paystack API call that errored out with no response body).
  rawPayload Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([reference])
  @@index([userId])
  @@index([createdAt])
}
