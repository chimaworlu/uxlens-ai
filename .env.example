# Copy to .env and fill in real values. Never commit .env.

# --- Database (PostgreSQL) ---
# Port 5433, not the default 5432 — see docker-compose.yml for why.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/uxlens_ai"
# Connections per running instance. Use 1 on Vercel (many instances), 10 on the worker.
DB_POOL_MAX=10

# --- Redis (BullMQ) ---
REDIS_URL="redis://localhost:6379"

# --- Auth.js (NextAuth v5) ---
AUTH_SECRET="generate-with: npx auth secret"
NEXTAUTH_URL="http://localhost:3000"

# --- Google OAuth (FR-1) ---
# If unset, the Google sign-in button renders disabled with a dev note.
# Email + password auth must keep working regardless.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Set to "true" once the two values above are real — a build-time flag
# read client-side (app/(marketing)/auth/page.tsx's GoogleButton) to
# decide the button's enabled state; the actual credentials above never
# reach the client. Keep this in sync by hand with whether they're set.
NEXT_PUBLIC_GOOGLE_SIGNIN_ENABLED="false"

# --- AI providers ---
# DeepSeek is the confirmed provider for every pipeline pass (AGENTS.md Section 2).
DEEPSEEK_API_KEY=""
# Claude is an optional, config-toggled upgrade for synthesis/chat. Leave unset to run DeepSeek-only.
ANTHROPIC_API_KEY=""
AI_SYNTHESIS_PROVIDER="deepseek" # "deepseek" | "claude"
AI_CHAT_PROVIDER="deepseek"      # "deepseek" | "claude"

# --- Cloudflare R2 (file storage) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="uxlens-ai-documents"
R2_ENDPOINT=""

# --- Nodemailer (transactional email, Gmail SMTP) ---
# Generate an App Password at myaccount.google.com/apppasswords — requires
# 2-Step Verification on the sending account. Not the account's login password.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# --- Paystack (billing, NGN only) ---
# Paystack's Plan + Subscription objects give Paystack-managed recurring
# billing (it bills the saved authorization on schedule, retries failed
# charges, fires webhook events), matching FR-33/34.
#
# Test keys (Dashboard -> Settings -> API Keys & Webhooks, Test mode)
# start with pk_test_/sk_test_; live keys start with pk_live_/sk_live_.
# Both test and live use the same base URL (api.paystack.co) — only the
# key differs.
PAYSTACK_PUBLIC_KEY=""
PAYSTACK_SECRET_KEY=""
# No separate webhook secret to generate — Paystack signs webhook
# payloads with the SAME secret key above (HMAC-SHA512 of the raw request
# body, sent in the x-paystack-signature header), unlike the previous
# Flutterwave integration's separate dashboard-configured secret hash.
# Just set your webhook URL in Dashboard -> Settings -> API Keys &
# Webhooks; nothing extra needed here.
#
# The Pro plan's plan_code (e.g. "PLN_xxxxxxxxxxxx"), created once via
# POST /plan (see scripts/create-paystack-plan.ts, `npm run
# billing:create-plan`) or the dashboard. Referenced on every checkout so
# subscribers all land on the same plan instead of a new one being
# created per signup.
PAYSTACK_PRO_PLAN_CODE=""

# --- Observability ---
# Create a project at sentry.io, then paste its DSN here. Leave empty to
# run without error tracking (Sentry.init no-ops on a missing dsn). Not a
# secret — a DSN only lets a client SEND events, not read them — so one
# NEXT_PUBLIC_ var covers server, edge, client, and the worker process,
# rather than needing a public/private pair.
NEXT_PUBLIC_SENTRY_DSN=""

NODE_ENV="development"
