# Copy to .env and fill in real values. Never commit .env.

# --- Database (PostgreSQL) ---
# Port 5433, not the default 5432 — see docker-compose.yml for why.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/uxlens_ai"

# --- Redis (BullMQ) ---
REDIS_URL="redis://localhost:6379"

# --- Auth.js (NextAuth v5) ---
AUTH_SECRET="generate-with: npx auth secret"
NEXTAUTH_URL="http://localhost:3000"

# --- Google OAuth (FR-1) ---
# If unset, the Google sign-in button renders disabled with a dev note.
# Email + password auth must keep working regardless.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- AI providers ---
# DeepSeek is the confirmed provider for every pipeline pass (AGENTS.md Section 2).
DEEPSEEK_API_KEY=""
# Claude is an optional, config-toggled upgrade for synthesis/chat. Leave unset to run DeepSeek-only.
ANTHROPIC_API_KEY=""
AI_SYNTHESIS_PROVIDER="deepseek" # "deepseek" | "claude"
AI_CHAT_PROVIDER="deepseek"      # "deepseek" | "claude"

# --- Cloudflare R2 (file storage) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="uxlens-ai-documents"
R2_ENDPOINT=""

# --- Nodemailer (transactional email, Gmail SMTP) ---
# Generate an App Password at myaccount.google.com/apppasswords — requires
# 2-Step Verification on the sending account. Not the account's login password.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# --- Flutterwave (billing, NGN only) ---
FLUTTERWAVE_PUBLIC_KEY=""
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_WEBHOOK_SECRET_HASH="" # verif-hash header value to check webhook signatures against

# --- Observability ---
SENTRY_DSN=""

NODE_ENV="development"
